#!/bin/sh
#
# NextDesk installer step (Calamares process module, runs on the live system as root after the
# image is copied to disk and the bootloader is set up; the medium's package pool is an apt
# source in the target, see calamares-sources-media).
#
# - Firmware: the packages for the firmware files the kernel asked for during this live boot
#   and didn't find, like Debian's installer (hw-detect). nextdesk-desktop carries none.
# - Networking stays NetworkManager's: no interfaces in /etc/network/interfaces.
# - The installer's own files leave the installed system.

set -u

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
INDEX=/usr/share/nextdesk-installer/firmware.index   # "<firmware path> <package>" per line

echo "NextDesk: firmware for this machine..."
missing=$( { journalctl -k -b --no-pager -o cat 2>/dev/null || dmesg; } |
    sed -n -e 's/.*firmware: failed to load \([^ ]*\).*/\1/p' \
           -e 's/.*Direct firmware load for \([^ ]*\) failed.*/\1/p' | sort -u)
packages=''
for fw in $missing; do
    pkg=$(awk -v f="$fw" '$1 == f || $1 ~ ("/" f "$") { print $2; exit }' "$INDEX" 2>/dev/null)
    if [ -n "$pkg" ]; then
        echo "  $fw -> $pkg"
        case " $packages " in *" $pkg "*) ;; *) packages="$packages $pkg" ;; esac
    else
        echo "  $fw -> (no package)"
    fi
done
if [ -n "$packages" ]; then
    DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get install -y --no-install-recommends $packages ||
        echo "NextDesk: installing firmware failed (the system still works; add it later with apt)"
else
    echo "  nothing needed"
fi

# UEFI: Secure Boot needs Debian's signed shim and GRUB (the image installs without
# "recommends", so calamares-bootloader-config's grub-efi didn't pull them in).
if [ -d /sys/firmware/efi/efivars ]; then
    echo "NextDesk: signed bootloader for Secure Boot..."
    DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get install -y --no-install-recommends \
        shim-signed grub-efi-amd64-signed &&
    chroot "$CHROOT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot --recheck &&
    chroot "$CHROOT" update-grub ||
        echo "NextDesk: setting up the signed bootloader failed (turn Secure Boot off to boot)"
fi

# The NextDesk answers (wizard): computer name, root/admin passwords, SSH, Nextcloud + apps
python3 /usr/share/nextdesk-installer/apply-answers "$CHROOT"

# Only loopback in /etc/network/interfaces: NetworkManager manages every interface.
if [ -f "$CHROOT/etc/network/interfaces" ]; then
    printf 'auto lo\niface lo inet loopback\n' > "$CHROOT/etc/network/interfaces"
fi

rm -rf "$CHROOT/usr/share/nextdesk-installer" "$CHROOT/usr/lib/calamares/modules/nextdesk-postinstall" \
       "$CHROOT/usr/lib/live/config/9000-nextdesk-installer"
exit 0
