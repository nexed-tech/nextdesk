#!/usr/bin/python3
"""NextDesk installer, first part: what makes a machine NextDesk (runs before Calamares, as root,
in the live session).

  1. Nextcloud: server URL (checked: reachable, NextDesk app, pwa_suite install pages) and the
     apps to install as web apps. Wi-Fi from here if there's no network.
  2. This computer: name, root password, optional local admin account, optional SSH server.
  3. Summary.

The answers go to /run/nextdesk-installer/answers.json (root only); nextdesk-postinstall applies
them to the installed system (apply-answers). Calamares then does language, keyboard and disk.
Exit 0 = continue to Calamares.
"""

import json
import os
import re
import sys
import threading
import urllib.request

import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

sys.path.insert(0, '/usr/lib/nextdesk')

ANSWERS = '/run/nextdesk-installer/answers.json'
WALLPAPER = '/usr/share/nextdesk/wallpaper.svg'
# Same catalog and defaults as init/nextdesk-setup.sh
APPS = ['Calendar', 'Contacts', 'Files', 'Mail', 'Notes', 'Office', 'Photos', 'Talk', 'Tasks', 'Deck', 'Forms', 'News']
DEFAULT_APPS = {'Calendar', 'Contacts', 'Files', 'Mail', 'Notes', 'Office', 'Photos', 'Talk', 'Tasks'}

