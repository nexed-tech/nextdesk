    # --- helpers ------------------------------------------------------------------------------

    def label(self, text='', css=None, wrap=False, xalign=None):
        lbl = Gtk.Label(label=text)
        lbl.set_line_wrap(wrap)
        lbl.set_max_width_chars(56)
        if xalign is not None:
            lbl.set_xalign(xalign)
        else:
            lbl.set_justify(Gtk.Justification.CENTER)
        if css:
            lbl.get_style_context().add_class(css)
        return lbl

    def button(self, text, css, callback):
        b = Gtk.Button(label=text)
        b.get_style_context().add_class(css)
        b.connect('clicked', lambda _b: callback())
        return b

    def page(self, step, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_size_request(560, -1)
        if step:
            box.add(self.label(f'Step {step} of 5', 'step'))
        box.add(self.label(title, 'title'))
        return box

    def nav(self, box, back, next_text, next_cb, next_css='primary'):
        row = Gtk.Box(spacing=10)
        if back:
            row.pack_start(self.button('Back', 'link', lambda: self.show(back)), False, False, 0)
        row.pack_end(self.button(next_text, next_css, next_cb), False, False, 0)
        box.add(row)

    def show(self, page):
        self.stack.set_visible_child_name(page)

    def remember_page(self, stack, _param):
        name = stack.get_visible_child_name()
        if name not in ('wifi', 'wifipass'):
            self.page_before_wifi = name

    def draw_background(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        if self.wallpaper is None or (self.wallpaper.get_width(), self.wallpaper.get_height()) != (w, h):
            try:
                self.wallpaper = GdkPixbuf.Pixbuf.new_from_file_at_scale(WALLPAPER, w, h, False)
            except GLib.Error:
                self.wallpaper = None
        if self.wallpaper:
            Gdk.cairo_set_source_pixbuf(cr, self.wallpaper, 0, 0)
            cr.paint()
        return False

    @staticmethod
    def combo(items, active):
        """A ComboBoxText of (id, text) with typing-to-search, active = id."""
        combo = Gtk.ComboBoxText()
        for item_id, text in items:
            combo.append(item_id, text)
        if not combo.set_active_id(active):
            combo.set_active(0)
        combo.set_wrap_width(1)
        return combo

    # --- 1. Language, keyboard, timezone ------------------------------------------------------

    def build_language(self):
        box = self.page(1, 'Welcome to NextDesk OS')
        box.add(self.label('A desktop that is just your Nextcloud. This sets up the computer; it takes a few '
                           'minutes.', 'hint', wrap=True))
        box.add(self.label('Language', xalign=0))
        self.locale = self.combo([(l, l) for l in locales()], 'en_US.UTF-8')
        box.add(self.locale)
        self.layouts, self.variants = keyboard_layouts()
        box.add(self.label('Keyboard layout', xalign=0))
        self.keyboard = self.combo([(l, f'{d}  ({l})') for l, d in self.layouts], 'us')
        self.keyboard.connect('changed', lambda _c: self.fill_variants())
        box.add(self.keyboard)
        self.variant = Gtk.ComboBoxText()
        self.variant.connect('changed', lambda _c: self.apply_keyboard())
        box.add(self.variant)
        self.fill_variants()
        self.try_keys = Gtk.Entry(placeholder_text='Type here to try the keyboard')
        box.add(self.try_keys)
        box.add(self.label('Timezone', xalign=0))
        self.timezone = self.combo([(t, t.replace('_', ' ')) for t in timezones()], 'Europe/Amsterdam')
        box.add(self.timezone)
        self.timezone_hint = self.label('', 'hint', xalign=0)
        box.add(self.timezone_hint)
        self.timezone_picked = False   # set once the user chooses one: detection then leaves it alone
        self.timezone_detecting = False
        self.timezone.connect('changed', lambda _c: None if self.timezone_detecting
                              else setattr(self, 'timezone_picked', True))
        threading.Thread(target=self.detect_timezone, daemon=True).start()
        self.nav(box, None, 'Next', lambda: (self.show('server'), self.url.grab_focus()))
        return box

    def detect_timezone(self):
        """Timezone from the public IP, in the background. Keeps trying for a few minutes: the
        network may only come up once Wi-Fi is connected."""
        for _ in range(36):
            if self.timezone_picked:
                return
            tz = geoip_timezone()
            if tz:
                GLib.idle_add(self.set_detected_timezone, tz)
                return
            threading.Event().wait(5)

    def set_detected_timezone(self, tz):
        if self.timezone_picked:
            return False
        self.timezone_detecting = True
        if self.timezone.set_active_id(tz):
            self.timezone_hint.set_text('Detected from your network')
        self.timezone_detecting = False
        return False

    def fill_variants(self):
        layout = self.keyboard.get_active_id() or 'us'
        self.variant.remove_all()
        self.variant.append('', 'Default')
        for v, d in self.variants.get(layout, []):
            self.variant.append(v, d)
        self.variant.set_active_id('')
        self.apply_keyboard()

    def apply_keyboard(self):
        # Use the chosen layout right away (for the passwords on the next pages too)
        args = ['setxkbmap', '-layout', self.keyboard.get_active_id() or 'us']
        if self.variant.get_active_id():
            args += ['-variant', self.variant.get_active_id()]
        try:
            subprocess.run(args, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    # --- 2. Nextcloud -------------------------------------------------------------------------

    def build_server(self):
        box = self.page(2, 'Your Nextcloud')
        box.add(self.label('People sign in to this computer with their Nextcloud account, and its apps '
                           'become the apps on the shelf.', 'hint', wrap=True))
        row = Gtk.Box(spacing=8)
        self.url = Gtk.Entry(placeholder_text='https://cloud.example.com')
        self.url.connect('activate', lambda _e: self.run_check())
        self.url.connect('changed', lambda _e: self.server_status.set_text(''))
        row.pack_start(self.url, True, True, 0)
        row.add(self.button('Check', 'primary', self.run_check))
        box.add(row)
        self.check_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.add(self.check_box)
        box.add(self.label('Apps on the shelf', xalign=0))
        grid = Gtk.FlowBox(max_children_per_line=4, min_children_per_line=3, selection_mode=Gtk.SelectionMode.NONE)
        self.app_checks = {}
        for app in APPS:
            cb = Gtk.CheckButton(label=app)
            cb.set_active(app in DEFAULT_APPS)
            self.app_checks[app] = cb
            grid.add(cb)
        box.add(grid)
        self.apps_hint = self.label(self.APPS_HINT, 'hint', wrap=True)
        box.add(self.apps_hint)
        self.server_status = self.label(css='warn', wrap=True)
        box.add(self.server_status)
        self.nav(box, 'language', 'Next', self.server_next)
        return box

    def normalized_url(self):
        url = self.url.get_text().strip().rstrip('/')
        if url and not re.match(r'^https?://', url):
            url = 'https://' + url
        return url

    def run_check(self, then=None):
        url = self.normalized_url()
        if not url:
            return
        for child in self.check_box.get_children():
            self.check_box.remove(child)
        self.check_box.add(self.label(f'Checking {url}…', 'hint', xalign=0))
        self.check_box.show_all()
        def check():
            results = check_server(url)
            policy = find_policy(url) if results and results[0][0] is not False else None
            GLib.idle_add(self.show_check, url, results, then, policy)
        threading.Thread(target=check, daemon=True).start()

    def show_check(self, url, results, then, policy=None):
        self.checked = (url, results)
        self.policy = policy
        for child in self.check_box.get_children():
            self.check_box.remove(child)
        if policy:
            results = results + [(True, f'Managed by the NextDesk device policy "{policy[1].get("name", "?")}": '
                                        'it sets the apps, updates and more')]
        for ok, text in results:
            mark, css = ('✓', 'ok') if ok else ('✗', 'bad') if ok is False else ('!', 'warn')
            self.check_box.add(self.label(f'{mark}  {text}', css, wrap=True, xalign=0))
        # Departments (NextDesk app): the computer name then starts with the chosen one
        self.department = None
        departments = (policy[2] if policy else {}).get('departments') or []
        if departments:
            row = Gtk.Box(spacing=8, margin_top=6)
            row.pack_start(self.label('Department', xalign=0), False, False, 0)
            self.department = Gtk.ComboBoxText()
            self.department.append('', 'None')
            for department in departments:
                self.department.append(department, department)
            self.department.set_active(1 if len(departments) == 1 else 0)
            row.pack_start(self.department, False, False, 0)
            self.check_box.add(row)
            if (policy[2] or {}).get('per_hostname'):
                self.check_box.add(self.label('The computer name starts with the department, which picks its '
                                              'device policy.', 'hint', wrap=True, xalign=0))
        self.check_box.show_all()
        # A policy decides the apps (and changes them later): show them, not editable
        policy_apps = (policy[1].get('nextcloud') or {}).get('apps') if policy else None
        for app, cb in self.app_checks.items():
            if policy_apps:
                cb.set_active(app in policy_apps)
            cb.set_sensitive(not policy_apps)
        self.apps_hint.set_text('The device policy sets these apps.' if policy_apps else self.APPS_HINT)
        if then:
            then()

    def server_next(self):
        url = self.normalized_url()
        if not url:
            self.server_status.set_text('Enter the address of your Nextcloud.')
            return
        if not any(cb.get_active() for cb in self.app_checks.values()):
            self.server_status.set_text('Choose at least one app.')
            return
        if self.checked is None or self.checked[0] != url:
            self.run_check(then=self.server_next)
            return
        if any(ok is False for ok, _t in self.checked[1]) and self.server_status.get_text() != self.WARN_CONTINUE:
            # Offline installs are fine: the browser policy is set up at first boot.
            self.server_status.set_text(self.WARN_CONTINUE)
            return
        self.server_status.set_text('')
        # A department proposes <department>-<6 hex of the MAC>, unless the name was typed by hand
        department = self.department.get_active_id() if self.department else ''
        proposal = f'{department}-{mac_suffix() or "001"}' if department else 'nextdesk'
        if self.hostname.get_text().strip() in ('', self.proposed_hostname):
            self.hostname.set_text(proposal)
        self.proposed_hostname = proposal
        self.show('computer')
        self.hostname.grab_focus()

    # --- 3. This computer ---------------------------------------------------------------------

    def build_computer(self):
        box = self.page(3, 'This computer')
        box.add(self.label('Computer name', xalign=0))
        self.hostname = Gtk.Entry(text='nextdesk')
        box.add(self.hostname)
        box.add(self.label('Root password (for administrators, on the console)', xalign=0))
        self.root1 = Gtk.Entry(placeholder_text='At least 8 characters', visibility=False)
        self.root2 = Gtk.Entry(placeholder_text='Repeat', visibility=False)
        box.add(self.root1)
        box.add(self.root2)
        self.admin = Gtk.CheckButton(label='Also create a local admin account (works without Nextcloud)')
        self.admin.connect('toggled', lambda b: self.admin_box.set_visible(b.get_active()))
        box.add(self.admin)
        self.admin_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_start=24)
        self.admin_user = Gtk.Entry(placeholder_text='Username, e.g. admin')
        self.admin1 = Gtk.Entry(placeholder_text='Password, at least 8 characters', visibility=False)
        self.admin2 = Gtk.Entry(placeholder_text='Repeat', visibility=False)
        for w in (self.admin_user, self.admin1, self.admin2):
            self.admin_box.add(w)
        box.add(self.admin_box)
        self.ssh = Gtk.CheckButton(label='Install an SSH server (remote access for administrators)')
        # SSH signs in with the local admin account (root password login over SSH stays off)
        self.ssh.connect('toggled', lambda b: b.get_active() and self.admin.set_active(True))
        box.add(self.ssh)
        box.add(self.label('SSH signs in with the local admin account; root can\'t sign in over SSH.', 'hint',
                           wrap=True, xalign=0))
        self.computer_status = self.label(css='bad', wrap=True)
        box.add(self.computer_status)
        self.nav(box, 'server', 'Next', self.computer_next)
        return box

    def computer_next(self):
        error = self.computer_error()
        self.computer_status.set_text(error or '')
        if not error:
            self.show('disk')

    def computer_error(self):
        if not re.match(r'^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$', self.hostname.get_text().strip()):
            return 'Computer name: letters, digits and dashes (no dash at the start or end).'
        if len(self.root1.get_text()) < 8:
            return 'The root password needs at least 8 characters.'
        if self.root1.get_text() != self.root2.get_text():
            return "The root passwords don't match."
        if self.ssh.get_active() and not self.admin.get_active():
            return 'The SSH server needs the local admin account to sign in with.'
        if self.admin.get_active():
            user = self.admin_user.get_text().strip()
            if not re.match(r'^[a-z][a-z0-9_-]{0,30}$', user) or user == 'root':
                return 'Admin username: lowercase letters, digits, - and _, starting with a letter.'
            if len(self.admin1.get_text()) < 8:
                return 'The admin password needs at least 8 characters.'
            if self.admin1.get_text() != self.admin2.get_text():
                return "The admin passwords don't match."
        return None

    # --- 4. Disk -------------------------------------------------------------------------------

    def build_disk(self):
        box = self.page(4, 'The disk')
        if self.disk is None:
            box.add(self.label('No internal disk of at least 16 GB was found. NextDesk OS installs on the '
                               "computer's own disk (not on USB drives).", 'bad', wrap=True))
            self.encrypt = Gtk.CheckButton()   # not shown; keeps the rest simple
            self.understood = Gtk.CheckButton()
            self.disk_status = self.label()
            self.pass_box = Gtk.Box()
            row = Gtk.Box()
            row.pack_start(self.button('Back', 'link', lambda: self.show('computer')), False, False, 0)
            box.add(row)
            return box
        box.add(self.label('NextDesk OS installs on this computer\'s disk:', 'hint', wrap=True))
        box.add(self.label(f'{self.disk["model"]}  ({human_size(self.disk["size"])}, {self.disk["path"]})', 'disk'))
        box.add(self.label('Everything on this disk will be erased: other systems, files, everything. '
                           'Your own files live in Nextcloud and aren\'t affected.', 'warn', wrap=True))
        self.encrypt = Gtk.CheckButton(label='Encrypt the disk')
        self.encrypt.set_active(True)
        self.encrypt.connect('toggled', lambda _b: self.update_encrypt())
        box.add(self.encrypt)
        self.encrypt_hint = self.label(css='hint', wrap=True, xalign=0)
        box.add(self.encrypt_hint)
        self.pass_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_start=24)
        self.pass1 = Gtk.Entry(placeholder_text='Disk passphrase, at least 8 characters', visibility=False)
        self.pass2 = Gtk.Entry(placeholder_text='Repeat', visibility=False)
        self.pass_box.add(self.pass1)
        self.pass_box.add(self.pass2)
        box.add(self.pass_box)
        self.understood = Gtk.CheckButton(label=f'I understand that everything on {self.disk["model"]} will be erased')
        box.add(self.understood)
        self.disk_status = self.label(css='bad', wrap=True)
        box.add(self.disk_status)
        self.nav(box, 'computer', 'Next', self.disk_next)
        return box

    def update_encrypt(self):
        if self.disk is None:
            return
        on = self.encrypt.get_active()
        if self.tpm:
            self.encrypt_hint.set_text('This computer has a security chip (TPM 2.0): the disk unlocks by itself '
                                       'at start-up, no password needed. You get a recovery key at the end '
                                       'of the installation.' if on else 'The disk isn\'t encrypted: anyone '
                                       'with the disk can read it.')
            self.pass_box.set_visible(False)
        else:
            self.encrypt_hint.set_text('This computer has no security chip (TPM 2.0), so the disk asks for a '
                                       'passphrase at every start-up. You also get a recovery key at the end.'
                                       if on else 'The disk isn\'t encrypted: anyone with the disk can read it.')
            self.pass_box.set_visible(on)

    def disk_next(self):
        if self.encrypt.get_active() and not self.tpm:
            if len(self.pass1.get_text()) < 8:
                self.disk_status.set_text('The disk passphrase needs at least 8 characters.')
                return
            if self.pass1.get_text() != self.pass2.get_text():
                self.disk_status.set_text("The passphrases don't match.")
                return
        if not self.understood.get_active():
            self.disk_status.set_text('Tick the box to confirm the disk may be erased.')
            return
        self.disk_status.set_text('')
        self.fill_summary()
        self.show('summary')

    # --- 5. Summary -----------------------------------------------------------------------------

    def build_summary(self):
        box = self.page(5, 'Ready to install')
        self.summary = self.label(wrap=True, xalign=0)
        box.add(self.summary)
        self.nav(box, 'disk', 'Erase the disk and install', self.start_install, 'danger')
        return box

    def apps(self):
        return [app for app in APPS if self.app_checks[app].get_active()]

    def policy_summary(self):
        if not self.policy:
            return 'Device policy:  none'
        url, policy, setting = self.policy
        text = f'Device policy:  {policy.get("name")} ({url})'
        name = self.hostname.get_text().strip().lower()
        group = name.split('-', 1)[0] if '-' in name else None
        if setting.get('per_hostname') and group and re.fullmatch(r'[a-z0-9]{1,30}', group):
            text += f', or {group}.json next to it if that exists (from the computer name)'
        return text

    def fill_summary(self):
        enc = ('yes, unlocks with the TPM' if self.tpm else 'yes, with a passphrase') if self.encrypt.get_active() else 'no'
        variant = self.variant.get_active_id()
        lines = [
            f'Language:  {self.locale.get_active_id()}',
            f'Keyboard:  {self.keyboard.get_active_id()}{" (" + variant + ")" if variant else ""}',
            f'Timezone:  {self.timezone.get_active_id()}',
            f'Nextcloud:  {self.normalized_url()}',
            f'Apps:  {", ".join(self.apps())}',
            self.policy_summary(),
            f'Computer name:  {self.hostname.get_text().strip()}',
            f'Local admin:  {self.admin_user.get_text().strip()}' if self.admin.get_active() else 'Local admin:  none',
            f'SSH server:  {"yes" if self.ssh.get_active() else "no"}',
            f'Disk:  {self.disk["model"]} ({human_size(self.disk["size"])}), erased',
            f'Encryption:  {enc}',
        ]
        self.summary.set_text('\n'.join(lines))

    # --- Installing ------------------------------------------------------------------------------

    def build_installing(self):
        box = self.page(None, 'Installing NextDesk OS')
        self.bar = Gtk.ProgressBar()
        box.add(self.bar)
        self.bar_text = self.label('Starting…', 'hint', wrap=True)
        box.add(self.bar_text)
        details = Gtk.Expander(label='Details')
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_min_content_height(220)
        self.log_view = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.CHAR)
        scroll.add(self.log_view)
        details.add(scroll)
        box.add(details)
        return box

    def start_install(self):
        answers = {
            'locale': self.locale.get_active_id(),
            'keyboard': self.keyboard.get_active_id(),
            'keyboard_variant': self.variant.get_active_id() or '',
            'timezone': self.timezone.get_active_id(),
            'nextcloud_url': self.normalized_url(),
            'apps': self.apps(),
            'policy_url': self.policy[0] if self.policy else None,
            'policy_per_hostname': bool(self.policy and self.policy[2].get('per_hostname')),
            'hostname': self.hostname.get_text().strip(),
            'root_password': self.root1.get_text(),
            'admin': {'user': self.admin_user.get_text().strip(), 'password': self.admin1.get_text()}
                     if self.admin.get_active() else None,
            'ssh': self.ssh.get_active(),
            'disk': self.disk,
            'encrypt': self.encrypt.get_active(),
            'tpm': self.encrypt.get_active() and self.tpm,
            'passphrase': self.pass1.get_text() if self.encrypt.get_active() and not self.tpm else None,
        }
        os.makedirs(RUN, mode=0o700, exist_ok=True)
        fd = os.open(ANSWERS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as f:
            json.dump(answers, f)
        self.run_install()

    def run_install(self):
        self.recovery_key = None
        self.error = None
        self.log_view.get_buffer().set_text('')
        self.bar.set_fraction(0)
        self.bar_text.set_text('Starting…')
        self.top.set_visible(False)   # no Wi-Fi changes while installing
        self.show('installing')
        threading.Thread(target=self.install_thread, daemon=True).start()

    def install_thread(self):
        with open(LOG, 'a', encoding='utf-8') as log:
            proc = subprocess.Popen(['python3', INSTALL], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, bufsize=1)
            for line in proc.stdout:
                line = line.rstrip('\n')
                if line.startswith('@@ RECOVERY '):
                    self.recovery_key = line[len('@@ RECOVERY '):]
                    log.write('@@ RECOVERY (recovery key created)\n')
                    continue
                log.write(line + '\n')
                log.flush()
                GLib.idle_add(self.on_line, line)
            code = proc.wait()
        GLib.idle_add(self.on_finished, code)

    def on_line(self, line):
        m = re.match(r'^@@ (\d+) (.*)$', line)
        if m:
            self.bar.set_fraction(int(m.group(1)) / 100)
            self.bar_text.set_text(m.group(2))
            return
        if line.startswith('@@ ERROR '):
            self.error = line[len('@@ ERROR '):]
            return
        buf = self.log_view.get_buffer()
        buf.insert(buf.get_end_iter(), line + '\n')
        self.log_view.scroll_to_iter(buf.get_end_iter(), 0, False, 0, 0)

    def on_finished(self, code):
        self.top.set_visible(True)
        for child in self.done_box.get_children():
            self.done_box.remove(child)
        if code == 0:
            self.done_title.set_text('NextDesk OS is installed')
            if self.recovery_key:
                self.done_box.add(self.label('Recovery key for the disk', xalign=0))
                key = self.label(self.recovery_key, 'key', wrap=True)
                key.set_selectable(True)
                key.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)   # at the dashes, not mid-group
                self.done_box.add(key)
                qr = self.qr_code(self.recovery_key)
                if qr:
                    self.done_box.add(qr)
                self.done_box.add(self.label('Scan it into your password manager now. It\'s the only way into '
                                             'the disk if the security chip or passphrase can\'t unlock it (for '
                                             'example after a firmware update). NextDesk also stores it in '
                                             'Nextcloud for your administrators at the first sign-in.', 'warn',
                                             wrap=True, xalign=0))
            self.done_box.add(self.label('Remove the installation medium, then restart. Sign in with your '
                                         'Nextcloud account.', 'hint', wrap=True))
            row = Gtk.Box()
            row.pack_end(self.button('Restart', 'primary', lambda: subprocess.run(['systemctl', 'reboot'])), False, False, 0)
            self.done_box.add(row)
        else:
            self.done_title.set_text('The installation failed')
            self.done_box.add(self.label(self.error or f'The installer stopped (exit {code}).', 'bad', wrap=True))
            buf = self.log_view.get_buffer()
            tail = '\n'.join(buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).splitlines()[-14:])
            last = self.label(tail, wrap=True, xalign=0)
            last.get_style_context().add_class('hint')
            last.set_selectable(True)
            self.done_box.add(last)
            self.done_box.add(self.label(f'The full log is in {LOG}.', 'hint', wrap=True))
            row = Gtk.Box(spacing=10)
            row.pack_start(self.button('Change settings', 'link', lambda: self.show('summary')), False, False, 0)
            row.pack_end(self.button('Try again', 'primary', self.run_install), False, False, 0)
            row.pack_end(self.button('Restart', 'link', lambda: subprocess.run(['systemctl', 'reboot'])), False, False, 0)
            self.done_box.add(row)
        self.done_box.show_all()
        self.show('done')

    @staticmethod
    def qr_code(text):
        """A QR code image of text (qrencode), or None."""
        try:
            png = subprocess.run(['qrencode', '-t', 'PNG', '-s', '6', '-m', '2', '-o', '-', text],
                                 capture_output=True, check=True).stdout
            loader = GdkPixbuf.PixbufLoader.new_with_type('png')
            loader.write(png)
            loader.close()
            return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
        except (OSError, subprocess.CalledProcessError, GLib.Error) as e:
            print(f'nextdesk installer: no QR code: {e!r}', file=sys.stderr)
            return None

    def build_done(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_size_request(560, -1)
        self.done_title = self.label('', 'title')
        box.add(self.done_title)
        self.done_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.add(self.done_box)
        return box


def main():
    Gtk.init(sys.argv)
    Wizard()
    Gtk.main()
    return 0


if __name__ == '__main__':
    sys.exit(main())
