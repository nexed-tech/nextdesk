# --- Data from the system -------------------------------------------------------------------

def locales():
    out = []
    try:
        for line in open('/usr/share/i18n/SUPPORTED', encoding='utf-8'):
            name, *rest = line.split()
            if rest == ['UTF-8'] and name.endswith('.UTF-8'):
                out.append(name)
    except OSError:
        pass
    return sorted(set(out)) or ['en_US.UTF-8']


def keyboard_layouts():
    """[(layout, description)], {layout: [(variant, description)]} from xkb's base.lst."""
    layouts, variants, section = [], {}, None
    try:
        for line in open('/usr/share/X11/xkb/rules/base.lst', encoding='utf-8'):
            if line.startswith('!'):
                section = line[1:].strip()
                continue
            parts = line.strip().split(None, 1)
            if len(parts) != 2:
                continue
            if section == 'layout':
                layouts.append((parts[0], parts[1]))
            elif section == 'variant':
                layout, desc = parts[1].split(':', 1)
                variants.setdefault(layout.strip(), []).append((parts[0], desc.strip()))
    except OSError:
        pass
    return sorted(layouts, key=lambda l: l[1].lower()) or [('us', 'English (US)')], variants


def timezones():
    try:
        out = subprocess.run(['timedatectl', 'list-timezones'], capture_output=True, text=True).stdout.split()
        if out:
            return out
    except OSError:
        pass
    return ['UTC']


def geoip_timezone():
    """The timezone for this network's public IP, or None. The lookup services installers use:
    Ubuntu's (as Ubiquity/Calamares do), then ipapi.co."""
    try:
        status, body = http_get('https://geoip.ubuntu.com/lookup', timeout=5)
        m = re.search(rb'<TimeZone>([^<]+)</TimeZone>', body) if status == 200 else None
        if m:
            return m.group(1).decode()
    except (OSError, ValueError):
        pass
    try:
        status, body = http_get('https://ipapi.co/timezone', timeout=5, headers={'User-Agent': 'nextdesk-installer'})
        if status == 200 and re.fullmatch(rb'[A-Za-z_]+(/[A-Za-z0-9_+-]+)+', body.strip()):
            return body.strip().decode()
    except (OSError, ValueError):
        pass
    return None


def primary_disk():
    """The disk NextDesk installs on: internal (not removable/USB/the install medium), NVMe first.
    {'path', 'model', 'size'} or None."""
    try:
        data = json.loads(subprocess.run(
            ['lsblk', '-J', '-b', '-d', '-o', 'NAME,PATH,TYPE,SIZE,RM,HOTPLUG,RO,TRAN,MODEL'],
            capture_output=True, text=True).stdout)
    except (OSError, ValueError):
        return None
    medium = ''
    try:
        source = subprocess.run(['findmnt', '-no', 'SOURCE', MEDIUM], capture_output=True, text=True).stdout.strip()
        medium = subprocess.run(['lsblk', '-no', 'PKNAME', source], capture_output=True, text=True).stdout.strip() \
            or os.path.basename(source)
    except OSError:
        pass
    truthy = lambda v: v in (True, 1, '1', 'true')
    disks = [d for d in data.get('blockdevices', [])
             if d.get('type') == 'disk' and not truthy(d.get('rm')) and not truthy(d.get('hotplug'))
             and not truthy(d.get('ro')) and d.get('tran') != 'usb' and d.get('name') != medium
             and not re.match(r'^(loop|sr|zram|ram|fd)', d.get('name', '')) and int(d.get('size') or 0) >= MIN_DISK]
    if not disks:
        return None
    disks.sort(key=lambda d: (d.get('tran') != 'nvme', d.get('name')))
    d = disks[0]
    return {'path': d['path'], 'model': (d.get('model') or 'Disk').strip(), 'size': int(d['size'])}


def has_tpm2():
    try:
        return open('/sys/class/tpm/tpm0/tpm_version_major').read().strip() == '2'
    except OSError:
        return False


def mac_suffix():
    """The last 6 hex digits of the first wired (else any) network card's MAC address, upper case:
    unique per machine and the same after a reinstall. '' if there's none."""
    cards = []
    for name in sorted(os.listdir('/sys/class/net')):
        if not os.path.exists(f'/sys/class/net/{name}/device'):   # lo, bridges, VPNs
            continue
        try:
            with open(f'/sys/class/net/{name}/address') as f:
                mac = f.read().strip().replace(':', '')
        except OSError:
            continue
        if re.fullmatch(r'[0-9a-fA-F]{12}', mac) and mac != '0' * 12:
            wireless = os.path.exists(f'/sys/class/net/{name}/wireless')
            cards.append((wireless, mac[-6:].upper()))
    return min(cards)[1] if cards else ''


def human_size(n):
    return f'{n / 1000 ** 4:.1f} TB' if n >= 1000 ** 4 else f'{n / 1000 ** 3:.0f} GB'


def http_get(url, timeout=10, headers=None):
    req = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def check_server(url):
    """[(ok: True/False/None, text)] for the three things NextDesk needs from the server."""
    results = []
    try:
        status, body = http_get(f'{url}/status.php')
        info = json.loads(body) if status == 200 else {}
        if info.get('installed'):
            note = ' (in maintenance mode)' if info.get('maintenance') else ''
            results.append((not info.get('maintenance'), f'Nextcloud {info.get("versionstring", "")} answers{note}'))
        else:
            return [(False, f'No Nextcloud at {url} (HTTP {status})')]
    except Exception as e:
        return [(False, f'Can\'t reach {url}: {getattr(e, "reason", e)}')]
    try:
        status, _ = http_get(f'{url}/ocs/v2.php/apps/nextdesk/api/v1/policy',
                             headers={'OCS-APIRequest': 'true', 'Accept': 'application/json'})
        results.append((True, 'NextDesk app installed') if status == 401 else
                       (False, 'NextDesk app not installed: sign-in with Nextcloud won\'t work until it is'))
    except Exception as e:
        results.append((False, f'NextDesk app: no answer ({e})'))
    try:
        status, body = http_get(f'{url}/apps/pwa_suite/install/files')
        results.append((True, 'pwa_suite install pages present') if status == 200 and b'rel="manifest"' in body else
                       (None, 'pwa_suite install pages missing: apps are installed from the app pages instead'))
    except Exception as e:
        results.append((None, f'pwa_suite: no answer ({e})'))
    return results


POLICY_INDEX = 'https://repo.nexed.tech/policy/index.json'


def find_policy(url):
    """(policy URL, policy, setting) of the device policy for this Nextcloud, or None: the URL the
    Nextcloud admin set (NextDesk app, admin page; setting = its per_hostname and departments),
    else NextDesk's index (policies/index.yaml in the NextDesk repository; setting {}). Index and
    policy are signed: checked like the machines do (nextdesk-policy, the NextDesk keyring)."""
    try:
        import importlib.machinery
        policy_tool = importlib.machinery.SourceFileLoader('nextdesk_policy', '/usr/lib/nextdesk/nextdesk-policy').load_module()
        policy_tool.POLICY = '/nonexistent'   # nothing in force yet: any serial is new
        # The Nextcloud admin's setting (NextDesk app) first, then NextDesk's index
        try:
            setting = policy_tool.ndlib.device_policy(url.rstrip('/'), timeout=10)
        except Exception:
            setting = {'url': None}
        policy_url = setting.pop('url')
        if policy_url:
            policy = policy_tool.download({'NEXTDESK_POLICY_URL': policy_url})
            return (policy_url, policy, setting) if policy else None
        index_data = policy_tool.fetch(POLICY_INDEX)
        if not policy_tool.verified(index_data, policy_tool.fetch(POLICY_INDEX + '.asc'), policy_tool.KEYRING):
            print('nextdesk installer: policy index: bad signature', file=sys.stderr)
            return None
        policy_url = json.loads(index_data).get(url.rstrip('/'))
        if not policy_url:
            return None
        policy = policy_tool.download({'NEXTDESK_POLICY_URL': policy_url})
        return (policy_url, policy, {}) if policy else None
    except Exception as e:
        print(f'nextdesk installer: no device policy lookup: {e!r}', file=sys.stderr)
        return None


