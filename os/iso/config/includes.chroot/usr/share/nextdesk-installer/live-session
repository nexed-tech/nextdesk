#!/bin/sh
# The NextDesk live session: just the installer, full screen. The wizard and Calamares run as root
# (the live user has passwordless sudo); when they're closed, the session ends and LightDM starts it
# again.
xfwm4 --compositor=off >/dev/null 2>&1 &
xfsettingsd >/dev/null 2>&1 &
xsetroot -solid '#0a1630' 2>/dev/null || true
# The NextDesk wizard first (Nextcloud, computer, accounts), then Calamares (language, disk).
exec sudo -E sh -c '/usr/share/nextdesk-installer/wizard && exec /usr/bin/calamares'
