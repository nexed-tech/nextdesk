# Not installed in the image: a package pool on the medium (file:/run/live/medium) that the
# installer installs from, offline.

# Bootloaders (the installer installs the one this machine needs). grub-pc
# (BIOS) conflicts with grub-efi-amd64, so build.sh adds it to the pool separately.
grub-efi
grub-efi-amd64
grub-efi-amd64-signed
shim-signed

# Optional SSH server (installer wizard: "Install an SSH server")
openssh-server

# Encrypted disks: unlocked at boot by dracut + systemd (TPM 2.0 or passphrase); the
# installer switches the installed system to dracut only when the disk is encrypted.
cryptsetup
dracut
dracut-core
systemd-cryptsetup
tpm2-tools
libtss2-esys-3.0.2-0t64
libtss2-rc0t64
libtss2-mu-4.0.1-0t64
libtss2-tcti-device0t64

# Firmware: the installer installs the packages for the firmware the kernel asked for
# during the live boot (like Debian's installer). nextdesk-desktop itself carries none.
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-mediatek
firmware-atheros
firmware-brcm80211
firmware-intel-sound
firmware-sof-signed
firmware-amd-graphics
firmware-intel-graphics
firmware-bnx2
firmware-bnx2x
firmware-libertas
firmware-ti-connectivity
firmware-cirrus
