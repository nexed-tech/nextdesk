# NextDesk OS itself (pulls in the desktop, Google Chrome, the patched docklike, ...)
nextdesk-desktop

# Kernel and live system (live-* are removed from the installed system)
linux-image-amd64
live-boot
live-config
live-config-systemd
user-setup
sudo

# The installer (removed from the installed system)
calamares
calamares-settings-debian

# Disk tools the installer needs (Calamares only recommends them, and the image installs without
# recommends): FAT for the EFI partition, btrfs if chosen, squashfs. They stay installed.
dosfstools
btrfs-progs
squashfs-tools

# Used by the installer's language, keyboard and clock steps (locale-gen, setupcon, hwclock);
# also only recommended somewhere, so not pulled in by the no-recommends image.
locales
util-linux-extra
console-setup
kbd

# Wi-Fi regulatory database (NetworkManager recommends it); without it Wi-Fi uses the most
# restrictive world settings.
wireless-regdb
