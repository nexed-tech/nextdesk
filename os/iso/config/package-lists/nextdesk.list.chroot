# NextDesk OS itself (nextdesk-desktop, which pulls in the desktop, Google Chrome, the patched
# docklike, ...) isn't listed here: build.sh builds it from the checkout into packages.chroot/,
# which live-build installs by itself. Listing it too made the second ("live") package pass see
# the local copy against repo.nexed.tech's and refuse it as a downgrade.

# Kernel and live system (live-* are removed from the installed system)
linux-image-amd64
live-boot
live-config
live-config-systemd
user-setup
sudo

# Disk tools the installer (nextdesk-installer/install) uses: FAT for the EFI partition, squashfs
# (unsquashfs copies the system), LUKS + TPM enrollment (systemd-cryptenroll and the TPM libraries
# it loads). They stay installed.
dosfstools
cryptsetup-bin
squashfs-tools
systemd-cryptsetup
libtss2-esys-3.0.2-0t64
libtss2-rc0t64
libtss2-mu-4.0.1-0t64
libtss2-tcti-device0t64

# setxkbmap: the installer applies the chosen keyboard layout right away
x11-xkb-utils

# Used by the installer's language, keyboard and clock steps (locale-gen, setupcon, hwclock);
# also only recommended somewhere, so not pulled in by the no-recommends image.
locales
util-linux-extra
console-setup
kbd

# Wi-Fi regulatory database (NetworkManager recommends it); without it Wi-Fi uses the most
# restrictive world settings.
wireless-regdb
