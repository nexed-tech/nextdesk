#!/bin/sh
# NextDesk installer setup inside the image (runs after all packages are installed).
set -e

I=/usr/share/nextdesk-installer

# The installer: setup window (wizard), install script, answers -> installed system
chmod 755 "$I/wizard" "$I/install" "$I/apply-answers" "$I/live-session" /usr/lib/live/config/9000-nextdesk-installer
# NetworkManager manages all networking (debootstrap brings ifupdown; it would claim interfaces
# listed in /etc/network/interfaces, which NetworkManager then leaves alone).
apt-get purge -y -qq ifupdown >/dev/null

# Firmware index for the installer (install, firmware step): "<path below the firmware dir> <package>" for every
# file in the firmware packages that are in the medium's pool (firmware-packages, from
# installer.list.binary). The packages themselves aren't installed in the image.
work=$(mktemp -d)
cd "$work"
apt-get update -qq
for pkg in $(cat "$I/firmware-packages"); do
    apt-get download -qq "$pkg" >/dev/null 2>&1 || { echo "W: firmware package $pkg not found" >&2; continue; }
done
: > "$I/firmware.index"
for deb in ./*.deb; do
    [ -e "$deb" ] || continue
    pkg=$(dpkg-deb -f "$deb" Package)
    dpkg-deb -c "$deb" | awk '{print $NF}' | sed -n 's#^\./\(usr/\)\{0,1\}lib/firmware/##p' |
        grep -v '/$' | sed -e 's/\.\(xz\|zst\)$//' -e "s/\$/ $pkg/" >> "$I/firmware.index"
done
cd /
rm -rf "$work"
echo "NextDesk firmware index: $(wc -l < "$I/firmware.index") files"
