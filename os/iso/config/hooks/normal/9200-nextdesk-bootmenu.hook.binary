#!/bin/sh
# NextDesk OS installer medium: the boot menu entries live-build generates ("Live system
# (amd64)", "... fail-safe mode") get NextDesk names, in GRUB (UEFI and BIOS) and isolinux.
set -e

for cfg in binary/boot/grub/grub.cfg binary/isolinux/live.cfg; do
    [ -e "$cfg" ] || continue
    sed -i \
        -e 's/Live system ([a-z0-9]* fail-safe mode)/Install NextDesk OS (safe graphics)/' \
        -e 's/Live system ([a-z0-9]*)/Install NextDesk OS/' \
        "$cfg"
    echo "NextDesk boot menu: $cfg"
done
