#!/bin/sh
set -e

case "$1" in
    remove)
        # Removes the browser policy and pin helper; the browser then removes the apps.
        /usr/lib/nextdesk/nextdesk-setup --uninstall >/dev/null 2>&1 || true
        pam-auth-update --package --remove nextdesk
        systemctl disable --now nextdesk-watchdog.timer nextdesk-policy.timer >/dev/null 2>&1 || true
        systemctl disable nextdesk-config.service >/dev/null 2>&1 || true
        ;;
esac

exit 0
