        return box

    def build_setpin(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_size_request(380, -1)
        box.add(self.label('Choose a PIN', 'title'))
        box.add(self.label('6 to 12 digits. Use it to unlock, and to sign in on this computer when '
                           'there is no network.', 'hint', wrap=True))
        self.setpin_1 = Gtk.Entry(placeholder_text='PIN', visibility=False,
                                  input_purpose=Gtk.InputPurpose.PIN, max_length=12)
        self.setpin_2 = Gtk.Entry(placeholder_text='Repeat PIN', visibility=False,
                                  input_purpose=Gtk.InputPurpose.PIN, max_length=12)
        self.setpin_1.connect('activate', lambda _e: self.setpin_2.grab_focus())
        self.setpin_2.connect('activate', lambda _e: self.setpin_save())
        box.add(self.setpin_1)
        box.add(self.setpin_2)
        save = Gtk.Button(label='Save PIN and sign in')
        save.get_style_context().add_class('primary')
        save.connect('clicked', lambda _b: self.setpin_save())
        box.add(save)
        self.setpin_error = self.label(css='error', wrap=True)
        box.add(self.setpin_error)
        skip = Gtk.Button(label='Not now')
        skip.get_style_context().add_class('link')
        skip.connect('clicked', lambda _b: self.setpin_skip())
        box.add(skip)
        return box

    @staticmethod
    def initials(name):
        parts = [p for p in name.split() if p]
        return ((parts[0][0] + (parts[-1][0] if len(parts) > 1 else '')) if parts else '?').upper()

    def show(self, page, error=''):
        self.stack.set_visible_child_name(page)
        if page == 'home':
            self.home_error.set_text(error)
        elif page == 'local':
            self.local_error.set_text(error)
            self.local_user.grab_focus()
        elif page == 'pin':
            self.pin_error.set_text(error)
            self.pin_entry.set_text('')
            self.pin_entry.grab_focus()
        elif page == 'setpin':
            self.setpin_error.set_text(error)
            self.setpin_1.set_text('')
            self.setpin_2.set_text('')
            self.setpin_1.grab_focus()

    def ask_pin(self, user, locked=False):
        self.pin_user = user
        name = self.status.get(user, {}).get('displayname') or user
        self.pin_avatar.set_text(self.initials(name))
        self.pin_name.set_text(f'Locked: {name}' if locked else name)
        self.pin_back.set_visible(not locked)
        self.show('pin')

    def tick(self):
        now = time.localtime()
        self.clock.set_text(time.strftime('%H:%M', now))
        self.pin_clock.set_text(time.strftime('%H:%M', now))
        self.date.set_text(time.strftime('%A %d %B', now))
        return True

    def draw_background(self, widget, cr):
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        if self.wallpaper is None or (self.wallpaper.get_width(), self.wallpaper.get_height()) != (w, h):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(WALLPAPER, w, h, False)
                self.wallpaper = pix
            except GLib.Error:
                self.wallpaper = None
        if self.wallpaper:
            Gdk.cairo_set_source_pixbuf(cr, self.wallpaper, 0, 0)
            cr.paint()
        return False

    # --- Nextcloud Login Flow v2 -------------------------------------------------------------

    def start_flow(self):
        self.flow_id += 1
        flow = self.flow_id
        self.busy_text.set_text('Connecting to Nextcloud…')
        self.show('busy')
        device = f'NextDesk ({socket.gethostname()})'

        def run():
            try:
                login_url, endpoint, token = ndlib.login_flow_start(self.server, device)
            except Exception as e:
                GLib.idle_add(self.flow_failed, flow, f'Could not reach {self.server}. Check the network. ({e})')
                return
            GLib.idle_add(self.flow_show, flow, login_url)
            deadline = time.time() + FLOW_TIMEOUT
            while time.time() < deadline and flow == self.flow_id:
                time.sleep(POLL_SECONDS)
                try:
                    result = ndlib.login_flow_poll(endpoint, token)
                except Exception:
                    continue
                if result:
                    GLib.idle_add(self.flow_done, flow, result)
                    return
            GLib.idle_add(self.flow_failed, flow, 'Sign-in timed out. Try again.')

        threading.Thread(target=run, daemon=True).start()

    def flow_show(self, flow, url):
        if flow == self.flow_id:
            self.web.load_uri(url)
            self.show('web')

    def flow_failed(self, flow, message):
        if flow == self.flow_id:
            self.reset_web()
            self.show('home', message)

    def cancel_flow(self):
        self.flow_id += 1
        self.reset_web()
        self.show('home')

    def reset_web(self):
        self.web.load_uri('about:blank')
        self.web.get_context().get_website_data_manager().clear(
            WebKit2.WebsiteDataTypes.ALL, 0, None, None, None)

    def flow_done(self, flow, result):
        if flow != self.flow_id:
            return
        self.reset_web()
        self.busy_text.set_text('Signing in…')
        self.show('busy')
        login, app_password = result['loginName'], result['appPassword']

        def run():
            try:
                info = ndlib.api(self.server, login, app_password, 'GET', 'policy')
                user = ndlib.username_for(info['user'].get('displayname', ''), info['user']['id'])
            except Exception as e:
                GLib.idle_add(self.flow_failed, flow,
                              f'Signed in to Nextcloud, but the NextDesk app on the server did not answer ({e}).')
                return
            GLib.idle_add(self.signed_in_to_nextcloud, flow, user, login, app_password)

        threading.Thread(target=run, daemon=True).start()

    def signed_in_to_nextcloud(self, flow, user, login, app_password):
        if flow != self.flow_id:
            return
        if self.status.get(user, {}).get('has_pin'):
            self.mode = 'nextcloud'
            self.authenticate(user, ndlib.encode_secret(login, app_password))
        else:
            self.new_signin = (user, login, app_password)
            self.show('setpin')

    def setpin_save(self):
        pin = self.setpin_1.get_text()
        if not ndlib.valid_pin(pin):
            self.show('setpin', 'Use 6 to 12 digits.')
            return
        if pin != self.setpin_2.get_text():
            self.show('setpin', "The PINs don't match.")
            return
        self.finish_new_signin(pin)

    def setpin_skip(self):
        self.finish_new_signin(None)

    def finish_new_signin(self, pin):
        if not self.new_signin:
            self.show('home')
            return
        user, login, app_password = self.new_signin
        self.new_signin = None
        self.setpin_1.set_text('')
        self.setpin_2.set_text('')
        self.busy_text.set_text('Signing in…')
        self.show('busy')
        self.mode = 'nextcloud'
        self.authenticate(user, ndlib.encode_secret(login, app_password, pin))

    def pin_signin(self):
        pin = self.pin_entry.get_text()
        if not pin or not self.pin_user:
            return
        self.pin_entry.set_text('')
        self.busy_text.set_text('Signing in…')
        self.show('busy')
        self.mode = 'pin'
        self.authenticate(self.pin_user, ndlib.PIN_PREFIX + pin)

    # --- LightDM ------------------------------------------------------------------------------

    def authenticate(self, user, secret):
        # Every prompt in this authentication gets the same answer: the NextDesk module reads it
        # first, and Debian's pam_unix asks again (no try_first_pass) for local accounts.
        self.pending_secret = secret
        if self.ld.get_in_authentication():
            self.ld.cancel_authentication()
        try:
            self.ld.authenticate(user)
        except GLib.Error as e:
            self.pending_secret = None
            self.show('home', f'Could not sign in: {e.message}')

    def local_signin(self):
        user = self.local_user.get_text().strip()
        if not user:
            return
        self.busy_text.set_text('Signing in…')
        self.show('busy')
        self.mode = 'local'
        self.authenticate(user, self.local_pass.get_text())

    def on_prompt(self, _greeter, _text, prompt_type):
        if self.pending_secret is not None:
            self.ld.respond(self.pending_secret)
        else:
            self.ld.cancel_authentication()

    def on_message(self, _greeter, text, _message_type):
        self.busy_text.set_text(text)

    def on_auth_complete(self, _greeter):
        self.pending_secret = None
        mode, self.mode = self.mode, None
        self.local_pass.set_text('')
        if self.ld.get_is_authenticated():
            try:
                self.ld.start_session_sync(SESSION)
            except GLib.Error as e:
                self.show('home', f'Could not start the desktop: {e.message}')
            return
        if mode == 'local':
            self.show('local', 'Wrong username or password.')
        elif mode == 'pin':
            # Wrong PIN, too many wrong PINs, revoked, or offline for too long: PAM doesn't say
            # which, and a Nextcloud sign-in sorts out all of them.
            locked = not self.pin_back.get_visible()
            self.status = ndlib.load_status()
            for user, tile in self.tiles.items():   # a removed PIN takes the tile with it
                tile.set_visible(bool(self.status.get(user, {}).get('has_pin')))
            if self.status.get(self.pin_user, {}).get('has_pin'):
                self.ask_pin(self.pin_user, locked)
                self.pin_error.set_text('PIN not accepted. Try again, or sign in with Nextcloud '
                                        '(needed after a long time offline).')
            else:
                self.show('home', 'Your PIN no longer works on this computer. Sign in with Nextcloud.')
        else:
            self.show('home', 'This account could not be signed in on this computer. Ask your administrator.')


def main():
    Gtk.init(sys.argv)
    Greeter()
    Gtk.main()


if __name__ == '__main__':
    main()
