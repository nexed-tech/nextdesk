              box-shadow: none; }
button.tile:hover { background: rgba(255,255,255,0.12); }
.avatar { background: #0082c9; color: #ffffff; border-radius: 20px; font-weight: 600; }
.avatar-large { background: #0082c9; color: #ffffff; border-radius: 36px; font-size: 26px; font-weight: 600; }
.webframe { border-radius: 12px; }
"""


class Greeter:
    def __init__(self):
        self.server = ndlib.server_url()
        self.status = ndlib.load_status()   # local user -> {displayname, has_pin}
        self.flow_id = 0          # increases on every new flow / cancel, so stale polls are ignored
        self.pending_secret = None
        self.mode = None          # what's being authenticated: 'nextcloud', 'pin' or 'local'
        self.pin_user = None
        self.new_signin = None    # (user, login, app_password) while choosing a PIN

        self.ld = LightDM.Greeter()
        self.ld.connect('show-prompt', self.on_prompt)
        self.ld.connect('show-message', self.on_message)
        self.ld.connect('authentication-complete', self.on_auth_complete)
        self.ld.connect_to_daemon_sync()

        settings = Gtk.Settings.get_default()
        settings.set_property('gtk-theme-name', 'Orchis-Dark')
        settings.set_property('gtk-icon-theme-name', 'Papirus-Dark')
        settings.set_property('gtk-font-name', 'Inter 11')
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.window = Gtk.Window()
        self.window.set_decorated(False)
        screen = Gdk.Screen.get_default()
        self.window.set_default_size(screen.get_width(), screen.get_height())
        self.window.move(0, 0)

        overlay = Gtk.Overlay()
        self.window.add(overlay)
        self.background = Gtk.DrawingArea()
        self.background.connect('draw', self.draw_background)
        self.wallpaper = None
        overlay.add(self.background)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               hhomogeneous=False, vhomogeneous=False, interpolate_size=True)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.get_style_context().add_class('card')
        card.set_halign(Gtk.Align.CENTER)
        card.set_valign(Gtk.Align.CENTER)
        card.add(self.stack)
        overlay.add_overlay(card)

        self.stack.add_named(self.build_home(), 'home')
        self.stack.add_named(self.build_web(), 'web')
        self.stack.add_named(self.build_busy(), 'busy')
        self.stack.add_named(self.build_local(), 'local')
        self.stack.add_named(self.build_pin(), 'pin')
        self.stack.add_named(self.build_setpin(), 'setpin')

        # Wi-Fi (ndwifi): optional, the login screen works without it
        self.wifi = None
        try:
            import ndwifi
            self.wifi = ndwifi.Wifi(self.stack, self.label, lambda: self.show('home'))
        except Exception as e:  # no NetworkManager, no libnm, ...
            print(f'nextdesk-greeter: no Wi-Fi panel: {e!r}', file=sys.stderr)

        power = Gtk.Box(spacing=8, margin=20)
        power.set_halign(Gtk.Align.END)
        power.set_valign(Gtk.Align.START)
        if self.wifi is not None:
            power.add(self.wifi.button)
        for icon, tip, can, action in (
                ('system-reboot-symbolic', 'Restart', LightDM.get_can_restart, LightDM.restart),
                ('system-shutdown-symbolic', 'Shut down', LightDM.get_can_shutdown, LightDM.shutdown)):
            if can():
                b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
                b.set_tooltip_text(tip)
                b.get_style_context().add_class('power')
                b.connect('clicked', lambda _b, a=action: a())
                power.add(b)
        overlay.add_overlay(power)

        self.window.show_all()
        self.show('home')
        GLib.timeout_add_seconds(1, self.tick)
        self.tick()

        # Signed out by the watchdog or a PIN check (device revoked in Nextcloud)
        revoked = [i.get('displayname') or u for u, i in self.status.items() if i.get('notice') == 'revoked']
        if revoked:
            self.home_error.set_text(f'{", ".join(revoked)}: this computer was removed from your Nextcloud '
                                     'account (or the account was disabled). Sign in with Nextcloud again.')

        # Unlocking (light-locker): straight to the locked user's PIN, if they have one.
        hint = self.ld.get_select_user_hint()
        if self.ld.get_lock_hint() and hint:
            if self.status.get(hint, {}).get('has_pin'):
                self.ask_pin(hint, locked=True)
            else:
                self.subtitle.set_text(f'Locked. Sign in again to continue as {hint}.')

    # --- UI ----------------------------------------------------------------------------------

    def label(self, text='', css=None, wrap=False):
        lbl = Gtk.Label(label=text)
        lbl.set_line_wrap(wrap)
        lbl.set_max_width_chars(40)
        lbl.set_justify(Gtk.Justification.CENTER)
        if css:
            lbl.get_style_context().add_class(css)
        return lbl

    def brand(self):
        """The NextDesk OS logo (design 1a without the desk bar): the N, "NextDesk" / "OS"."""
        row = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER)
        try:
            mark = GdkPixbuf.Pixbuf.new_from_file_at_size(MARK, 47, 52)
            row.add(Gtk.Image.new_from_pixbuf(mark))
        except GLib.Error as e:
            print(f'nextdesk-greeter: no logo: {e}', file=sys.stderr)
        words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        name = Gtk.Label(label='NextDesk', xalign=0)
        name.get_style_context().add_class('brand')
        os_tag = Gtk.Label(label='OS', xalign=0)
        os_tag.get_style_context().add_class('brand-os')
        words.add(name)
        words.add(os_tag)
        row.add(words)
        return row

    def build_home(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_size_request(380, -1)
        self.clock = self.label(css='clock')
        self.date = self.label(css='date')
        box.add(self.clock)
        box.add(self.date)
        box.add(Gtk.Box(margin_top=12))
        box.add(self.brand())
        host = self.server.split('://')[-1] if self.server else 'no server configured'
        self.subtitle = self.label(f'Sign in with your {host} account', 'hint', wrap=True)
        box.add(self.subtitle)
        # People who have signed in here before and set a PIN
        self.tiles = {}
        for user, info in sorted(self.status.items(), key=lambda kv: kv[1].get('displayname', kv[0]).lower()):
            if not info.get('has_pin'):
                continue
            tile = Gtk.Button()
            tile.get_style_context().add_class('tile')
            row = Gtk.Box(spacing=12)
            avatar = self.label(self.initials(info.get('displayname') or user), 'avatar')
            avatar.set_size_request(40, 40)
            row.add(avatar)
            name = self.label(info.get('displayname') or user)
            name.set_xalign(0)
            row.add(name)
            tile.add(row)
            tile.connect('clicked', lambda _b, u=user: self.ask_pin(u))
            box.add(tile)
            self.tiles[user] = tile
        signin = Gtk.Button(label='Sign in with Nextcloud')
        signin.get_style_context().add_class('primary')
        signin.connect('clicked', lambda _b: self.start_flow())
        signin.set_sensitive(bool(self.server))
        box.add(signin)
        self.home_error = self.label(css='error', wrap=True)
        box.add(self.home_error)
        local = Gtk.Button(label='Use a local account')
        local.get_style_context().add_class('link')
        local.connect('clicked', lambda _b: self.show('local'))
        box.add(local)
        return box

    def build_web(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        context = WebKit2.WebContext.new_ephemeral()
        self.web = WebKit2.WebView.new_with_context(context)
        self.web.set_size_request(480, 640)
        frame = Gtk.Frame()
        frame.get_style_context().add_class('webframe')
        frame.add(self.web)
        box.add(frame)
        cancel = Gtk.Button(label='Cancel')
        cancel.get_style_context().add_class('link')
        cancel.connect('clicked', lambda _b: self.cancel_flow())
        box.add(cancel)
        return box

    def build_busy(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_size_request(380, -1)
        spinner = Gtk.Spinner()
        spinner.set_size_request(48, 48)
        spinner.start()
        box.add(spinner)
        self.busy_text = self.label('Signing in…', wrap=True)
        box.add(self.busy_text)
        return box

    def build_local(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_size_request(380, -1)
        box.add(self.label('Local account', 'title'))
        self.local_user = Gtk.Entry(placeholder_text='Username')
        self.local_pass = Gtk.Entry(placeholder_text='Password', visibility=False)
        self.local_pass.connect('activate', lambda _e: self.local_signin())
        box.add(self.local_user)
        box.add(self.local_pass)
        go = Gtk.Button(label='Sign in')
        go.get_style_context().add_class('primary')
        go.connect('clicked', lambda _b: self.local_signin())
        box.add(go)
        self.local_error = self.label(css='error', wrap=True)
        box.add(self.local_error)
        back = Gtk.Button(label='Back')
        back.get_style_context().add_class('link')
        back.connect('clicked', lambda _b: self.show('home'))
        box.add(back)
        return box

    def build_pin(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_size_request(380, -1)
        self.pin_clock = self.label(css='clock')
        box.add(self.pin_clock)
        self.pin_avatar = self.label(css='avatar-large')
        self.pin_avatar.set_size_request(72, 72)
        self.pin_avatar.set_halign(Gtk.Align.CENTER)
        box.add(self.pin_avatar)
        self.pin_name = self.label(css='title')
        box.add(self.pin_name)
        self.pin_entry = Gtk.Entry(placeholder_text='PIN', visibility=False,
                                   input_purpose=Gtk.InputPurpose.PIN, max_length=12)
        self.pin_entry.set_alignment(0.5)
        self.pin_entry.connect('activate', lambda _e: self.pin_signin())
        box.add(self.pin_entry)
        go = Gtk.Button(label='Sign in')
        go.get_style_context().add_class('primary')
        go.connect('clicked', lambda _b: self.pin_signin())
        box.add(go)
        self.pin_error = self.label(css='error', wrap=True)
        box.add(self.pin_error)
        other = Gtk.Button(label='Sign in with Nextcloud instead')
        other.get_style_context().add_class('link')
        other.connect('clicked', lambda _b: self.start_flow())
        box.add(other)
        self.pin_back = Gtk.Button(label='Back')
        self.pin_back.get_style_context().add_class('link')
        self.pin_back.connect('clicked', lambda _b: self.show('home'))
