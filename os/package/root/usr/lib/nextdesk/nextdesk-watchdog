#!/usr/bin/python3
"""NextDesk watchdog (root; nextdesk-watchdog.timer, every few minutes).

For every user on this machine who signs in with Nextcloud, asks the server about this device:

  wipe requested   (Nextcloud: Settings > Security > Devices > Wipe device)
                   -> end the user's sessions, delete the local account and all its data,
                      tell Nextcloud the wipe is done (it then removes the device)
  revoked (401)    (device revoked, user disabled or deleted)
                   -> end the user's sessions, delete the app password and PIN; the user's files
                      stay, and only a full Nextcloud sign-in gets in again
  valid            -> remember the check (offline grace period) and the current policy
  unreachable / not confirming
                   -> nothing; losing the connection never logs anyone out (offline PIN
                      sign-in just stops once the policy's grace period has passed)

Then, if the disk's recovery key is still waiting for escrow (/var/lib/nextdesk/recovery-key.json,
from the installer or nextdesk-recovery-key --new), uploads it with a signed-in user's app
password and deletes the local copy.

Then, with the app password of a user on the desktop now, reports this computer for the NextDesk
computers page (ndreport.check_in: hourly, or at once for another user, policy or version).
"""

import json
import os
import shutil
import subprocess
import sys
import syslog

sys.path.insert(0, '/usr/lib/nextdesk')
import ndlib  # noqa: E402
import ndreport  # noqa: E402


def log(msg, prio=syslog.LOG_INFO):
    syslog.syslog(prio, msg)


def end_sessions(user):
    subprocess.run(['/usr/bin/loginctl', 'terminate-user', user], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wipe(user, nc_uid, creds):
    end_sessions(user)
    subprocess.run(['/usr/bin/pkill', '-KILL', '-u', user], check=False)
    subprocess.run(['/usr/sbin/userdel', '--remove', user], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    mapping = ndlib.load_mapping()
    mapping.pop(nc_uid, None)
    ndlib.save_mapping(mapping)
    shutil.rmtree(ndlib.user_dir(user), ignore_errors=True)
    ndlib.update_status(user, remove=True)
    try:
        ndlib.wipe_done(creds)
    except Exception as e:
        log(f'NextDesk watchdog: wiped {user}, but could not report it to Nextcloud: {e}', syslog.LOG_WARNING)
    log(f'NextDesk watchdog: wiped {user} ({nc_uid}) as requested by Nextcloud', syslog.LOG_WARNING)


def check(user, nc_uid):
    creds = ndlib.read_json(ndlib.paths(user)[0])
    if not creds:
        return   # signed out of this device already (or never fully signed in)
    try:
        if ndlib.wipe_requested(creds):
            wipe(user, nc_uid, creds)
            return
    except Exception:
        pass   # unreachable: the check below says the same
    result, info = ndlib.check_online(creds)
    if result == 'ok':
        ndlib.checked_ok(user, info)
        return creds
    elif result == 'revoked':
        end_sessions(user)
        ndlib.forget_device(user, 'revoked')
        log(f'NextDesk watchdog: Nextcloud refused the app password of {user}; signed out', syslog.LOG_WARNING)


def escrow():
    """Uploads a waiting recovery key with the first user whose app password works."""
    pending = ndlib.read_json(ndlib.RECOVERY_KEY)
    if not pending:
        return
    error = None
    for nc_uid, user in sorted(ndlib.load_mapping().items()):
        creds = ndlib.read_json(ndlib.paths(user)[0])
        if not creds:
            continue
        try:
            ndlib.escrow_recovery_key(creds)
            log(f'NextDesk watchdog: disk recovery key stored in Nextcloud (sent as {nc_uid})')
            return
        except ndlib.ApiError as e:
            error = 'the server has no recovery key escrow (update the NextDesk app)' if e.status == 404 else str(e)
        except Exception as e:
            error = repr(e)
    if error and error != pending.get('last_error'):
        # Logged once per new reason, not every few minutes
        log(f'NextDesk watchdog: disk recovery key not stored in Nextcloud yet: {error}', syslog.LOG_WARNING)
        pending['last_error'] = error
        ndlib.write_private_json(ndlib.RECOVERY_KEY, pending)


def desktop_users():
    """Users with a graphical session now (empty if loginctl can't tell)."""
    try:
        out = subprocess.run(['loginctl', 'list-sessions', '--json=short'], capture_output=True, text=True).stdout
        users = set()
        for s in json.loads(out or '[]'):
            kind = subprocess.run(['loginctl', 'show-session', str(s['session']), '-p', 'Type', '--value'],
                                  capture_output=True, text=True).stdout.strip()
            if s.get('class') == 'user' and kind in ('x11', 'wayland'):
                users.add(s.get('user'))
        return users
    except Exception:
        return set()


def check_in(verified):
    """Reports this computer for the NextDesk computers page (ndreport) with the app password of a
    user who is on the desktop now and whose check just passed; nobody: the machine's own
    contact (nextdesk-policy) keeps it up to date."""
    on_desktop = desktop_users()
    for user, creds in verified:
        if user not in on_desktop:
            continue
        try:
            if ndreport.check_in(creds, user):
                state = ndlib.read_json(ndreport.STATE) or {}
                if state.pop('last_error', None):
                    ndlib.write_private_json(ndreport.STATE, state)
        except Exception as e:
            error = 'the server has no computers page yet (NextDesk app < 0.5.0)' \
                if isinstance(e, ndlib.ApiError) and e.status == 404 else str(e)
            state = ndlib.read_json(ndreport.STATE) or {}
            if state.get('last_error') != error:   # once per new reason
                log(f'NextDesk watchdog: check-in not sent: {error}', syslog.LOG_WARNING)
                state['last_error'] = error
                ndlib.write_private_json(ndreport.STATE, state)
        return


def main():
    syslog.openlog('nextdesk-watchdog', syslog.LOG_PID, syslog.LOG_AUTHPRIV)
    if os.geteuid() != 0:
        sys.exit('Run as root.')
    verified = []
    for nc_uid, user in sorted(ndlib.load_mapping().items()):
        try:
            creds = check(user, nc_uid)
            if creds:
                verified.append((user, creds))
        except Exception as e:
            log(f'NextDesk watchdog: checking {user} failed: {e!r}', syslog.LOG_ERR)
    try:
        escrow()
    except Exception as e:
        log(f'NextDesk watchdog: recovery key escrow failed: {e!r}', syslog.LOG_ERR)
    try:
        check_in(verified)
    except Exception as e:
        log(f'NextDesk watchdog: check-in failed: {e!r}', syslog.LOG_ERR)
    return 0


if __name__ == '__main__':
    sys.exit(main())
