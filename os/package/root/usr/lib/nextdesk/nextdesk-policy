#!/usr/bin/python3
"""NextDesk device policy (root; nextdesk-policy.timer, at boot and every 15 minutes).

  nextdesk-policy             fetch, verify, apply (what the timer runs)
  nextdesk-policy --status    the policy in force and anything waiting

The policy URL is NEXTDESK_POLICY_URL in /etc/nextdesk/nextdesk.conf (none = no device policy).
When the Nextcloud admin set one for the server (NextDesk app, admin page), that one is followed.
With NEXTDESK_POLICY_PER_HOSTNAME=yes (also from the admin's setting), the policy of the machine's
hostname group comes first: sales-001 -> <directory of the URL>/sales.json, the URL itself when
that doesn't exist (HTTP 404) or the name has no '-'.
Fetches <url> and its detached signature <url>.asc, checks the signature with gpgv against the
NextDesk archive keyring (or NEXTDESK_POLICY_KEYRING), validates it (ndpolicy) and only takes a
higher serial than the last good one from the same file. Anything wrong (offline, bad signature,
invalid, older) keeps the last good policy; it never undoes a machine's configuration because of
a broken file.

  nextdesk-policy --logout    a forced logout (nextdesk-logout.timer, at the warning time): the
                              warning in every session (/run/nextdesk/notice.json, shown by
                              nextdesk-session-agent), then NextDesk users are signed out at the time

Applies:
  nextcloud.apps   at once (nextdesk-config: the browser installs/removes web apps)
  nextcloud.url    when no NextDesk user is signed in (at the latest: the next sign-in): app
                   passwords and PINs of the old server are dropped, the login screen moves to the
                   new server; local accounts are relinked by Nextcloud user id at sign-in
  url_change, session
                   forced logouts with a warning: nextdesk-logout.timer runs --logout warn_minutes
                   before each one
  wallpaper        downloaded and checked (sha256); /var/lib/nextdesk/wallpaper points at it (the
                   desktop's default wallpaper and the login screen use that path)
  screen_lock      by nextdesk-session-agent, in each session (it runs as the user)
  updates, packages

Every run, also without a device policy, reports to the NextDesk computers page (ndreport.contact,
device token): last contact and the policy in force.
"""

import datetime
import hashlib
import json
import re
import os
import subprocess
import sys
import syslog
import tempfile
import time
import urllib.error
import urllib.request

sys.path.insert(0, '/usr/lib/nextdesk')
import ndlib  # noqa: E402
import ndpolicy  # noqa: E402
import ndreport  # noqa: E402

KEYRING = '/usr/share/keyrings/nextdesk-archive-keyring.gpg'
POLICY = os.path.join(ndlib.STATE_DIR, 'policy.json')   # the last good policy (no secrets)
STATE = os.path.join(ndlib.STATE_DIR, 'policy-state.json')   # {pending_url, last_error}


def log(msg, prio=syslog.LOG_INFO):
    syslog.syslog(prio, msg)
    if sys.stdout.isatty():
        print(msg)


def read_state():
    return ndlib.read_json(STATE) or {}


def write_state(state):
    ndlib.write_private_json(STATE, state)


def note_error(error):
    """Logs a problem once per new reason, not every 15 minutes."""
    state = read_state()
    if state.get('last_error') != error:
        log(f'NextDesk policy: {error}; keeping the last good policy', syslog.LOG_WARNING)
        state['last_error'] = error
        write_state(state)


def fetch(url, limit=None):
    req = urllib.request.Request(url, headers={'User-Agent': 'nextdesk-policy', 'Cache-Control': 'no-cache'})
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = resp.read(limit + 1) if limit else resp.read()
    if limit and len(data) > limit:
        raise RuntimeError(f'larger than {limit // 2**20} MB')
    return data


def verified(data, signature, keyring):
    with tempfile.TemporaryDirectory() as tmp:
        d, s = os.path.join(tmp, 'policy'), os.path.join(tmp, 'policy.asc')
        with open(d, 'wb') as f:
            f.write(data)
        with open(s, 'wb') as f:
            f.write(signature)
        try:
            return subprocess.run(['gpgv', '--keyring', keyring, s, d], capture_output=True).returncode == 0
        except FileNotFoundError:
            raise RuntimeError('gpgv is missing (apt install gpgv)')


def policy_urls(conf):
    """[(url, group)] to try, in order: with NEXTDESK_POLICY_PER_HOSTNAME, the policy of this
    machine's hostname group next to the main one (sales-001: <dir>/sales.json); then the main
    policy (group None)."""
    main = conf.get('NEXTDESK_POLICY_URL')
    group = ndlib.hostname_group() if conf.get('NEXTDESK_POLICY_PER_HOSTNAME') == 'yes' else None
    return ([(f'{main.rsplit("/", 1)[0]}/{group}.json', group)] if group else []) + [(main, None)]


def download(conf):
    """The new verified policy (with 'source': the URL it came from), None when there's nothing
    newer, or raises with the reason. A hostname group without a policy (HTTP 404) gets the main
    one; anything else wrong with the group's policy keeps the last good one."""
    for url, group in policy_urls(conf):
        try:
            data = fetch(url)
        except urllib.error.HTTPError as e:
            if e.code == 404 and group:
                continue
            raise RuntimeError(f'cannot fetch {url} ({e})')
        except Exception as e:
            raise RuntimeError(f'cannot fetch {url} ({e})')
        try:
            signature = fetch(url + '.asc')
        except Exception as e:
            raise RuntimeError(f'cannot fetch {url}.asc ({e})')
        break
    if not verified(data, signature, conf.get('NEXTDESK_POLICY_KEYRING') or KEYRING):
        raise RuntimeError(f'{url}: bad or missing signature')
    try:
        policy, warnings = ndpolicy.validate(json.loads(data), strict=False)
    except (ValueError, ndpolicy.PolicyError) as e:
        raise RuntimeError(f'{url}: invalid policy ({e})')
    for w in warnings:
        log(f'NextDesk policy: {w} (newer than this machine knows)')
    current = ndlib.read_json(POLICY) or {}
    # Serials only compare within one file: another group's (or the main) policy has its own
    if current.get('source', conf.get('NEXTDESK_POLICY_URL')) == url and \
            policy.get('serial', 0) <= current.get('serial', -1):
        return None
    policy['source'] = url
    return policy


def sessions():
    """The user sessions now: [{user, class, type, ...}], or None if loginctl can't tell."""
    try:
        out = subprocess.run(['loginctl', 'list-sessions', '--json=short'],
                             capture_output=True, text=True, check=True).stdout
        result = []
        for s in json.loads(out or '[]'):
            kind = subprocess.run(['loginctl', 'show-session', str(s['session']), '-p', 'Type', '--value'],
                                  capture_output=True, text=True).stdout.strip()
            result.append({'user': s.get('user'), 'class': s.get('class'), 'type': kind})
        return result
    except Exception:
        return None


def signed_in_users():
    """Local NextDesk users (mapped to Nextcloud) with a session now; SSH/console admins don't count."""
    mapped = set(ndlib.load_mapping().values())
    current = sessions()
    if current is None:
        return mapped or {'?'}   # unknown: assume someone is, so nothing is switched under them
    return {s['user'] for s in current if s['user'] in mapped}


def desktop_in_use():
    """Is anyone (also a local admin) on the graphical desktop? The greeter's own session isn't."""
    current = sessions()
    return current is None or any(s['class'] == 'user' and s['type'] in ('x11', 'wayland') for s in current)


def config(*args):
    return subprocess.run(['/usr/sbin/nextdesk-config', *args], stdout=subprocess.DEVNULL).returncode == 0


def switch_server(url, apps):
    old = ndlib.server_url()
    for user in sorted(set(ndlib.load_mapping().values())):
        ndlib.forget_device(user, 'This computer now uses a different Nextcloud server. Sign in again.')
    if not config('--url', url, *(['--apps', apps] if apps else [])):
        raise RuntimeError(f'nextdesk-config --url {url} failed')
    # The login screen reads the server when it starts: restart it, unless someone (a local
    # admin) is on the desktop; the next login screen then has the new server anyway
    if not desktop_in_use():
        subprocess.run(['systemctl', 'try-restart', 'lightdm.service'], check=False)
    log(f'NextDesk policy: Nextcloud server changed from {old} to {url}', syslog.LOG_WARNING)


UPDATES_CONF = '/etc/apt/apt.conf.d/52nextdesk-updates'
UPDATES_TIMER = '/etc/systemd/system/apt-daily-upgrade.timer.d/nextdesk.conf'


def write_if_changed(path, text):
    """Writes the file; True if its content changed (None text: remove it)."""
    try:
        with open(path, encoding='utf-8') as f:
            old = f.read()
    except FileNotFoundError:
        old = None
    if old == text:
        return False
    if text is None:
        os.remove(path)
    else:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', encoding='utf-8') as f:
            f.write(text)
    return True


def apply_updates(updates):
    """updates: automatic updates with unattended-upgrades (Debian, security, NextDesk, Chrome)
    at a daily time, optionally rebooting when needed with nobody signed in. No updates key:
    NextDesk's settings are removed (Debian's defaults: nothing automatic)."""
    if updates is None:
        conf = timer = None
    else:
        on = '1' if updates.get('automatic') else '0'
        reboot = updates.get('reboot_at')
        conf = ('// NextDesk device policy (nextdesk-policy): automatic updates. Changed by the policy; don\'t edit.\n'
                f'APT::Periodic::Update-Package-Lists "{on}";\n'
                f'APT::Periodic::Unattended-Upgrade "{on}";\n'
                'APT::Periodic::AutocleanInterval "7";\n'
                'Unattended-Upgrade::Origins-Pattern {\n'
                '    "origin=Debian,codename=${distro_codename},label=Debian";\n'
                '    "origin=Debian,codename=${distro_codename}-updates,label=Debian";\n'
                '    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";\n'
                '    "origin=NextDesk,codename=${distro_codename}";\n'
                '    "origin=Google LLC,label=Google";\n'
                '};\n'
                'Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";\n'
                'Unattended-Upgrade::Remove-Unused-Dependencies "true";\n'
                f'Unattended-Upgrade::Automatic-Reboot "{"true" if reboot else "false"}";\n'
                'Unattended-Upgrade::Automatic-Reboot-WithUsers "false";\n'
                + (f'Unattended-Upgrade::Automatic-Reboot-Time "{reboot}";\n' if reboot else ''))
        timer = ('# NextDesk device policy: daily update time\n[Timer]\nOnCalendar=\n'
                 f'OnCalendar=*-*-* {updates.get("time", "03:00")}\nRandomizedDelaySec=30m\n')
    changed = write_if_changed(UPDATES_CONF, conf)
    if write_if_changed(UPDATES_TIMER, timer):
        subprocess.run(['systemctl', 'daemon-reload'], check=False)
        subprocess.run(['systemctl', 'restart', 'apt-daily-upgrade.timer'], check=False)
        changed = True
    if changed:
        log('NextDesk policy: automatic updates ' + ('removed' if updates is None else
            f'{"on at " + updates.get("time", "03:00") if updates.get("automatic") else "off"}'
            f'{", reboot at " + updates["reboot_at"] if updates.get("reboot_at") else ""}'))


DEBIAN_SOURCES = '/etc/apt/sources.list.d/debian.sources'
SOURCES_LIST = '/etc/apt/sources.list'
NEXTDESK_SOURCES = '/etc/apt/sources.list.d/nextdesk.sources'
APT_PROXY = '/etc/apt/apt.conf.d/51nextdesk-proxy'
POLICY_MARK = '# NextDesk device policy'


def debian_sources(debian='http://deb.debian.org/debian', security='http://security.debian.org/debian-security',
                   mark=True):
    return ((f'{POLICY_MARK} (nextdesk-policy): package mirror. Changed by the policy; don\'t edit.\n'
             if mark else '') +
            f'Types: deb\nURIs: {debian}\nSuites: trixie trixie-updates\n'
            'Components: main non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\n'
            f'Types: deb\nURIs: {security}\nSuites: trixie-security\n'
            'Components: main non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n')


def nextdesk_sources(mirror=None):
    url = (mirror or 'https://repo.nexed.tech').rstrip('/')
    return ((f'{POLICY_MARK} (nextdesk-policy): NextDesk mirror. Changed by the policy; don\'t edit.\n'
             if mirror else '') +
            f'Types: deb\nURIs: {url}/\nSuites: trixie\n'
            'Components: main\nSigned-By: /usr/share/keyrings/nextdesk-archive-keyring.gpg\n')


def apply_packages(packages):
    """packages: Debian mirror, security mirror, apt proxy. Without it, sources NextDesk wrote go
    back to Debian's defaults; sources someone edited by hand are left alone."""
    try:
        with open(DEBIAN_SOURCES, encoding='utf-8') as f:
            ours = f.read().startswith(POLICY_MARK)
    except FileNotFoundError:
        ours = True
    changed = False
    if packages and ('debian' in packages or 'security' in packages):
        # The policy's mirror replaces Debian lines in the old one-line format too (netinst)
        try:
            with open(SOURCES_LIST, encoding='utf-8') as f:
                lines = f.read().splitlines(keepends=True)
            disabled = [f'#{POLICY_MARK} disabled: {line}' if re.match(r'\s*deb(-src)?\s', line)
                        and re.search(r'/debian(-security)?/?\s', line) else line for line in lines]
            changed |= write_if_changed(SOURCES_LIST, ''.join(disabled))
        except FileNotFoundError:
            pass
        changed |= write_if_changed(DEBIAN_SOURCES, debian_sources(
            packages.get('debian', 'http://deb.debian.org/debian').rstrip('/'),
            packages.get('security', 'http://security.debian.org/debian-security').rstrip('/')))
    elif ours:
        changed |= write_if_changed(DEBIAN_SOURCES, debian_sources(mark=False))
    # NextDesk's repository: a mirror (same signed files, so the same key), or the default when
    # the policy (that wrote it) no longer sets one
    mirror = (packages or {}).get('nextdesk')
    try:
        with open(NEXTDESK_SOURCES, encoding='utf-8') as f:
            nextdesk_ours = f.read().startswith(POLICY_MARK)
    except FileNotFoundError:
        nextdesk_ours = True
    if mirror or nextdesk_ours:
        changed |= write_if_changed(NEXTDESK_SOURCES, nextdesk_sources(mirror))
    proxy = (packages or {}).get('proxy')
    changed |= write_if_changed(APT_PROXY, f'{POLICY_MARK}: apt proxy\nAcquire::http::Proxy "{proxy}";\n'
                                if proxy else None)
    if changed:
        log('NextDesk policy: package sources ' + (', '.join(f'{k} {v}' for k, v in sorted(packages.items()))
                                                   if packages else 'back to Debian\'s defaults'))


def apply_server(policy):
    conf = ndlib.read_conf()
    nc = policy.get('nextcloud') or {}
    url = (nc.get('url') or '').rstrip('/')
    apps = ','.join(nc.get('apps') or [])
    state = read_state()

    if url and url != conf.get('NEXTDESK_URL', '').rstrip('/'):
        users = signed_in_users()
        if users:
            if state.get('pending_url') != url:
                log(f'NextDesk policy: Nextcloud server changes to {url} once nobody is signed in '
                    f'(now: {", ".join(sorted(users))})')
                state['pending_url'] = url
                write_state(state)
            return
        switch_server(url, apps)
    elif apps and apps != conf.get('NEXTDESK_APPS', ''):
        if not config('--apps', apps):
            raise RuntimeError('nextdesk-config --apps failed')
        log(f'NextDesk policy: apps are now {apps}')
    state.pop('pending_url', None)
    write_state(state)


# --- Forced logouts (url_change.logout_at, session.logout_at) --------------------------------

LOGOUT_TIMER = '/etc/systemd/system/nextdesk-logout.timer'
NOTICE = '/run/nextdesk/notice.json'   # shown by nextdesk-session-agent in every session


def url_change_pending(policy):
    url = ((policy.get('nextcloud') or {}).get('url') or '').rstrip('/')
    return bool(url) and url != ndlib.read_conf().get('NEXTDESK_URL', '').rstrip('/')


def logout_events(policy, now):
    """The coming forced logouts: [(when, kind, warn_minutes)], local time, soonest first. The
    url_change one only while the server change waits (it's for making that happen)."""
    events = []
    session = policy.get('session') or {}
    if session.get('logout_at'):
        hour, minute = map(int, session['logout_at'].split(':'))
        when = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
        if when <= now:
            when += datetime.timedelta(days=1)
        events.append((when, 'session', session.get('warn_minutes', 10)))
    change = policy.get('url_change') or {}
    if change.get('logout_at') and url_change_pending(policy):
        when = datetime.datetime.strptime(change['logout_at'], '%Y-%m-%d %H:%M')
        if when > now:
            events.append((when, 'url_change', change.get('warn_minutes', 15)))
    return sorted(events)


def apply_logouts(policy):
    """nextdesk-logout.timer fires warn_minutes before each forced logout and runs --logout."""
    calendar = []
    for when, kind, warn in logout_events(policy, datetime.datetime.now()):
        start = when - datetime.timedelta(minutes=warn)
        calendar.append(start.strftime('*-*-* %H:%M:00' if kind == 'session' else '%Y-%m-%d %H:%M:00'))
    timer = None
    if calendar:
        timer = ('# NextDesk device policy (nextdesk-policy): warnings before forced logouts. Don\'t edit.\n'
                 '[Unit]\nDescription=NextDesk: forced logout (device policy)\n\n[Timer]\n'
                 + ''.join(f'OnCalendar={c}\n' for c in calendar)
                 + 'AccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n')
    elif not os.path.exists(LOGOUT_TIMER):
        return
    if not write_if_changed(LOGOUT_TIMER, timer):
        return
    subprocess.run(['systemctl', 'daemon-reload'], check=False)
    if timer:
        subprocess.run(['systemctl', 'enable', 'nextdesk-logout.timer'], check=False, capture_output=True)
        subprocess.run(['systemctl', 'restart', 'nextdesk-logout.timer'], check=False)
        log(f'NextDesk policy: forced logout warnings at {", ".join(calendar)}')
    else:
        log('NextDesk policy: no forced logouts')


def write_notice(notice):
    if notice is None:
        try:
            os.remove(NOTICE)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(NOTICE), mode=0o755, exist_ok=True)
    tmp = NOTICE + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(notice, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, NOTICE)


def logout():
    """At the warning time (nextdesk-logout.timer): the warning in every session, then the logout
    at the time. Root does the logout, so closing the warning (or killing the agent) doesn't skip
    it. A new policy without this logout cancels it."""
    started = datetime.datetime.now()
    due = [e for e in logout_events(ndlib.read_json(POLICY) or {}, started)
           if e[0] - started <= datetime.timedelta(minutes=e[2] + 1)]
    if not due:
        return 0
    when, kind, _ = due[0]
    message = ('This computer is moving to a new Nextcloud server. Save your work: you\'ll be signed out, '
               'then you sign in again.' if kind == 'url_change' else
               'Everyone is signed out at this time. Save your work.')
    write_notice({'at': when.timestamp(), 'kind': kind, 'message': message})
    log(f'NextDesk policy: forced logout ({kind}) at {when:%Y-%m-%d %H:%M}, users warned')
    try:
        while time.time() < when.timestamp():
            time.sleep(min(when.timestamp() - time.time(), 30))
            if (when, kind) not in [e[:2] for e in logout_events(ndlib.read_json(POLICY) or {}, started)]:
                log(f'NextDesk policy: forced logout ({kind}) at {when:%H:%M} cancelled by a new policy')
                return 0
        users = signed_in_users() - {'?'}
        for user in sorted(users):
            subprocess.run(['loginctl', 'terminate-user', user], check=False)
        log(f'NextDesk policy: forced logout ({kind}): ' + (', '.join(sorted(users)) or 'nobody was signed in'),
            syslog.LOG_WARNING)
    finally:
        write_notice(None)
    if kind == 'url_change':
        time.sleep(5)   # the sessions closing
        run()   # the waiting server change, now that nobody is signed in
    return 0


# --- Wallpaper ------------------------------------------------------------------------------

WALLPAPER = os.path.join(ndlib.STATE_DIR, 'wallpaper')   # symlink: the desktop and login screen use it
POLICY_WALLPAPER = os.path.join(ndlib.STATE_DIR, 'wallpaper-policy')
DEFAULT_WALLPAPER = '/usr/share/nextdesk/wallpaper.svg'


def sha256_file(path):
    try:
        with open(path, 'rb') as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def apply_wallpaper(wallpaper):
    """wallpaper: downloaded once per sha256 (from the signed policy, so it's the admin's file).
    Without it: NextDesk's own. Running sessions follow (nextdesk-session-agent)."""
    if wallpaper:
        if sha256_file(POLICY_WALLPAPER) != wallpaper['sha256']:
            try:
                data = fetch(wallpaper['url'], limit=32 * 2**20)
            except Exception as e:
                raise RuntimeError(f'wallpaper: cannot fetch {wallpaper["url"]} ({e})')
            if hashlib.sha256(data).hexdigest() != wallpaper['sha256']:
                raise RuntimeError(f'wallpaper: {wallpaper["url"]} doesn\'t match its sha256')
            tmp = POLICY_WALLPAPER + '.tmp'
            with open(tmp, 'wb') as f:
                f.write(data)
            os.chmod(tmp, 0o644)
            os.replace(tmp, POLICY_WALLPAPER)
            log(f'NextDesk policy: wallpaper {wallpaper["url"]} downloaded')
        target = POLICY_WALLPAPER
    else:
        target = DEFAULT_WALLPAPER
    try:
        current = os.readlink(WALLPAPER)
    except OSError:
        current = None
    if current != target:
        tmp = WALLPAPER + '.tmp'
        if os.path.lexists(tmp):
            os.remove(tmp)
        os.symlink(target, tmp)
        os.replace(tmp, WALLPAPER)
        if not wallpaper:
            log('NextDesk policy: wallpaper back to NextDesk\'s own')
    if not wallpaper and os.path.exists(POLICY_WALLPAPER):
        os.remove(POLICY_WALLPAPER)


def apply(policy):
    apply_updates(policy.get('updates'))
    apply_packages(policy.get('packages'))
    # One part failing (say a wallpaper that won't download) doesn't hold up the others
    errors = []
    for part in (apply_server, apply_logouts, lambda p: apply_wallpaper(p.get('wallpaper'))):
        try:
            part(policy)
        except Exception as e:
            errors.append(str(e))
    if errors:
        raise RuntimeError('; '.join(errors))


def follow_server_setting(conf):
    """The Nextcloud admin sets the device policy for the server's machines (NextDesk app): its
    URL, and whether machines look for their hostname group's policy first. When a URL is set,
    both become ours. No URL set, offline or an older app: keep what we have."""
    server = conf.get('NEXTDESK_URL', '').rstrip('/')
    if not server:
        return conf
    try:
        setting = ndlib.device_policy(server)
    except Exception:
        return conf
    url = setting['url']
    if not url:
        return conf
    changed = False
    if url != conf.get('NEXTDESK_POLICY_URL'):
        ndlib.set_conf('NEXTDESK_POLICY_URL', url)
        log(f'NextDesk policy: policy URL is now {url} (set on {server})')
        changed = True
    # An app older than 0.4.0 doesn't know the setting (None): the machine's own stays
    per_hostname = None if setting['per_hostname'] is None else 'yes' if setting['per_hostname'] else ''
    if per_hostname is not None and per_hostname != conf.get('NEXTDESK_POLICY_PER_HOSTNAME', ''):
        ndlib.set_conf('NEXTDESK_POLICY_PER_HOSTNAME', per_hostname or None)
        log(f'NextDesk policy: policy per hostname group {"on" if per_hostname else "off"} (set on {server})')
        changed = True
    return ndlib.read_conf() if changed else conf


def report_contact():
    """The machine's own report for the NextDesk computers page (device token, no login): last
    contact and the policy now in force. No token yet: the watchdog's next check-in gets one."""
    server = ndlib.server_url()
    if not server:
        return
    state = ndlib.read_json(ndreport.STATE) or {}
    try:
        ndreport.contact(server)
        error = None
    except Exception as e:
        error = 'the server has no computers page yet (NextDesk app < 0.5.0)' \
            if isinstance(e, ndlib.ApiError) and e.status == 404 else str(e)
    if state.get('contact_error') != error:   # logged once per new reason
        if error:
            log(f'NextDesk policy: contact not sent: {error}', syslog.LOG_WARNING)
        state['contact_error'] = error
        ndlib.write_private_json(ndreport.STATE, state)


def run():
    conf = follow_server_setting(ndlib.read_conf())
    try:
        if conf.get('NEXTDESK_POLICY_URL'):
            apply_policy(conf)
    finally:
        report_contact()
    return 0


def apply_policy(conf):
    ok = True
    try:
        policy = download(conf)
    except RuntimeError as e:
        note_error(str(e))
        policy, ok = None, False
    if policy is not None:
        previous = (ndlib.read_json(POLICY) or {}).get('source')
        ndlib.write_private_json(POLICY, policy)
        os.chmod(POLICY, 0o644)
        log(f'NextDesk policy: {policy.get("name", "?")} serial {policy.get("serial")} received'
            + (f' (now from {policy["source"]})' if previous and previous != policy['source'] else ''))
    current = ndlib.read_json(POLICY)
    if current:
        try:
            apply(current)   # also retries a waiting server change
        except Exception as e:
            note_error(f'applying failed: {e}')
            ok = False
    state = read_state()
    if ok and state.pop('last_error', None):
        log('NextDesk policy: working again')
        write_state(state)


def status():
    conf = ndlib.read_conf()
    url = conf.get('NEXTDESK_POLICY_URL')
    if not url:
        print('No device policy (set one with: nextdesk-config --policy-url URL)')
        return 0
    policy = ndlib.read_json(POLICY)
    print(f'Policy URL: {url}')
    if conf.get('NEXTDESK_POLICY_PER_HOSTNAME') == 'yes':
        group = ndlib.hostname_group()
        print(f'Per group:  {ndlib.hostname()} -> ' +
              (f'group {group}: {policy_urls(conf)[0][0]} (the URL above if that doesn\'t exist)' if group else
               'no group (no "-" in the computer name): the URL above'))
    print(f'In force:   {policy.get("name")} serial {policy.get("serial")}'
          + (f' from {policy["source"]}' if policy.get('source') else '') if policy else 'In force:   none yet')
    state = read_state()
    if state.get('pending_url'):
        print(f'Waiting:    Nextcloud server change to {state["pending_url"]} (when nobody is signed in)')
    if state.get('last_error'):
        print(f'Last error: {state["last_error"]}')
    if policy:
        print(json.dumps(policy, indent=2, sort_keys=True))
    return 0


def main():
    syslog.openlog('nextdesk-policy', syslog.LOG_PID, syslog.LOG_DAEMON)
    if '--status' in sys.argv[1:]:
        return status()
    if os.geteuid() != 0:
        sys.exit('Run as root.')
    if '--logout' in sys.argv[1:]:
        return logout()
    return run()


if __name__ == '__main__':
    sys.exit(main())
